# --- APLICACIÓN ---
PORT=3005
APP_URL=http://localhost:3005

# --- BASE DE DATOS (Para Docker) ---
# (Puedes dejar estas por defecto para que funcione Docker local)
DB_USER=admin_calma
DB_PASSWORD=calma_secret_2024
DB_NAME=fundacion_calma_db

# URL para Prisma LOCAL (usa localhost:5433)
# Docker IGNORA esto y usa db-calma:5432 (configurado en docker-compose.yml)
DATABASE_URL="postgresql://admin_calma:calma_secret_2024@localhost:5433/fundacion_calma_db?schema=public"

# --- SEGURIDAD (Login) ---
JWT_SECRET=tu_clave_secreta_cambia_esto_en_desarrollo

# --- CORREOS ---
# Render Free bloquea SMTP (puertos 465/587). En producción usa resend o google-script.
#
# Opción A — Resend (gratis ~3000/mes): https://resend.com
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM="Fundación Calma <onboarding@resend.dev>"
# (Con dominio verificado en Resend puedes usar noreply@tudominio.org)
#
# Opción B — Google Apps Script (gratis, envía con tu Gmail):
# EMAIL_PROVIDER=google-script
# GOOGLE_SCRIPT_EMAIL_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec
# EMAIL_FROM="Fundación Calma <tu_email@gmail.com>"
#
# Opción C — SMTP (solo local; no funciona en Render Free):
# EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_contraseña_o_app_password
EMAIL_FROM="Fundación Calma <tu_email@gmail.com>"
