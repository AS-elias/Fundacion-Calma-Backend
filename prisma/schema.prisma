generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["comercial", "core", "public"]
}

model analisis_tareas {
  id                     Int                      @id @default(autoincrement())
  area_id                Int?
  titulo                 String                   @db.VarChar(200)
  subtitulo              String?                  @db.VarChar(200)
  estado                 String?                  @default("pendiente") @db.VarChar(30)
  creador_id             Int?
  fecha_creacion         DateTime?                @default(now()) @db.Timestamp(6)
  descripcion            String?
  fecha_limite           DateTime?                @db.Date
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  updated_at             DateTime?                @updatedAt @db.Timestamp(6)
  analisis_tarea_enlaces analisis_tarea_enlaces[]
  areas                  areas?                   @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios               usuarios?                @relation(fields: [creador_id], references: [id], onUpdate: NoAction)

  @@schema("comercial")
}

model analisis_tarea_enlaces {
  id              Int              @id @default(autoincrement())
  tarea_id        Int?
  nombre          String           @db.VarChar(255)
  url             String
  created_at      DateTime?        @default(now()) @db.Timestamp(6)
  updated_at      DateTime?        @updatedAt @db.Timestamp(6)
  analisis_tareas analisis_tareas? @relation(fields: [tarea_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tarea_id], map: "idx_analisis_tarea_enlaces_tarea")
  @@schema("comercial")
}

model analisis_colegios {
  id               Int       @id @default(autoincrement())
  codigo_modular   String?   @db.VarChar(20)
  nombre           String    @db.VarChar(200)
  correo           String?   @db.VarChar(120)
  telefono         String?   @db.VarChar(30)
  nivel            String?   @db.VarChar(80)
  director         String?   @db.VarChar(150)
  tipo             String?   @db.VarChar(30)
  ugel             String?   @db.VarChar(80)
  departamento     String?   @db.VarChar(80)
  distrito         String?   @db.VarChar(80)
  zona             String?   @db.VarChar(50)
  cantidad_alumnos Int?
  direccion        String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @updatedAt @db.Timestamp(6)

  @@index([codigo_modular], map: "idx_analisis_colegios_codigo_modular")
  @@index([tipo], map: "idx_analisis_colegios_tipo")
  @@schema("comercial")
}

model analisis_empresas {
  id            Int       @id @default(autoincrement())
  ruc           String?   @db.VarChar(11)
  nombre        String    @db.VarChar(200)
  correo        String?   @db.VarChar(120)
  telefono_fijo String?   @db.VarChar(30)
  celular       String?   @db.VarChar(30)
  departamento  String?   @db.VarChar(80)
  distrito      String?   @db.VarChar(80)
  direccion     String?
  sector        String?   @db.VarChar(120)
  estado        String?   @db.VarChar(30)
  descripcion   String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @updatedAt @db.Timestamp(6)

  @@index([ruc], map: "idx_analisis_empresas_ruc")
  @@index([estado], map: "idx_analisis_empresas_estado")
  @@schema("comercial")
}

model analisis_venues {
  id                 Int       @id @default(autoincrement())
  nombre             String    @db.VarChar(200)
  departamento       String?   @db.VarChar(80)
  distrito           String?   @db.VarChar(80)
  direccion          String?
  celular            String?   @db.VarChar(30)
  correo             String?   @db.VarChar(120)
  capacidad_personas Int?
  estado             String?   @db.VarChar(30)
  sitio_web          String?
  detalles           String?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @updatedAt @db.Timestamp(6)

  @@index([estado], map: "idx_analisis_venues_estado")
  @@schema("comercial")
}

model analisis_difusiones {
  id            Int       @id @default(autoincrement())
  nombre        String    @db.VarChar(200)
  tipo          String?   @db.VarChar(80)
  plataforma    String?   @db.VarChar(80)
  lugar         String?   @db.VarChar(150)
  contacto      String?   @db.VarChar(150)
  celular       String?   @db.VarChar(30)
  correo        String?   @db.VarChar(120)
  fecha         DateTime? @db.Date
  estado        String?   @db.VarChar(30)
  observaciones String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @updatedAt @db.Timestamp(6)

  @@index([estado], map: "idx_analisis_difusiones_estado")
  @@schema("comercial")
}

model convenio_archivos {
  id             Int        @id @default(autoincrement())
  convenio_id    Int?
  subido_por_id  Int?
  nombre_archivo String     @db.VarChar(255)
  url_archivo    String
  fecha_subida   DateTime?  @default(now()) @db.Timestamp(6)
  convenios      convenios? @relation(fields: [convenio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios       usuarios?  @relation(fields: [subido_por_id], references: [id], onUpdate: NoAction)

  @@index([convenio_id], map: "idx_archivos_convenio")
  @@schema("comercial")
}

model convenio_comentarios {
  id             Int        @id @default(autoincrement())
  convenio_id    Int?
  usuario_id     Int?
  comentario     String
  fecha_creacion DateTime?  @default(now()) @db.Timestamp(6)
  convenios      convenios? @relation(fields: [convenio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios       usuarios?  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([convenio_id], map: "idx_comentarios_convenio")
  @@schema("comercial")
}

model convenio_historial {
  id             Int        @id @default(autoincrement())
  convenio_id    Int?
  usuario_id     Int?
  accion         String     @db.VarChar(50)
  descripcion    String
  fecha_creacion DateTime?  @default(now()) @db.Timestamp(6)
  convenios      convenios? @relation(fields: [convenio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios       usuarios?  @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)

  @@index([convenio_id], map: "idx_historial_convenio")
  @@schema("comercial")
}

model actividad_enlaces {
  id                     Int                     @id @default(autoincrement())
  actividad_id           Int?
  nombre_documento       String                  @db.VarChar(255)
  url                    String
  fecha_creacion         DateTime?               @default(now()) @db.Timestamp(6)
  desarrollo_actividades desarrollo_actividades? @relation(fields: [actividad_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([actividad_id], map: "idx_actividad_enlaces_actividad")
  @@schema("comercial")
}

model convenios {
  id                   Int                    @id @default(autoincrement())
  area_id              Int?
  entidad_nombre       String                 @db.VarChar(150)
  logo_url             String?
  ruc                  String?                @db.VarChar(11)
  rubro                String?                @db.VarChar(100)
  contacto_nombre      String?                @db.VarChar(150)
  telefono_contacto    String?                @db.VarChar(9)
  estado               String?
  fecha_expiracion     DateTime?              @db.Date
  creador_id           Int?
  fecha_creacion       DateTime?              @default(now()) @db.Timestamp(6)
  conexion             String?
  tipo                 String?
  convenio_archivos    convenio_archivos[]
  convenio_comentarios convenio_comentarios[]
  convenio_historial   convenio_historial[]
  areas                areas?                 @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios             usuarios?              @relation(fields: [creador_id], references: [id], onUpdate: NoAction)

  @@index([area_id], map: "idx_convenio_area")
  @@index([estado], map: "idx_convenios_estado")
  @@schema("comercial")
}

model desarrollo_actividades {
  id                Int                 @id @default(autoincrement())
  area_id           Int?
  titulo            String              @db.VarChar(200)
  descripcion       String?
  estado            String?             @default("PENDIENTE") @db.VarChar(30)
  fecha_limite      DateTime?           @db.Date
  creador_id        Int?
  fecha_creacion    DateTime?           @default(now()) @db.Timestamp(6)
  actualizado_en    DateTime?           @updatedAt @db.Timestamp(6)
  actividad_enlaces actividad_enlaces[]
  areas             areas?              @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios          usuarios?           @relation(fields: [creador_id], references: [id], onUpdate: NoAction)

  @@index([area_id], map: "idx_actividad_desarrollo_area")
  @@index([estado], map: "idx_actividad_desarrollo_estado")
  @@index([fecha_limite], map: "idx_actividad_desarrollo_fecha_limite")
  @@schema("comercial")
}

model estrategia_actividades {
  id                           Int                            @id @default(autoincrement())
  titulo                       String                         @db.VarChar(200)
  descripcion                  String?
  estado                       EstrategiaActividadEstado      @default(PENDIENTE)
  creado_por                   String?                        @db.VarChar(120)
  prioridad                    EstrategiaPrioridad            @default(MEDIA)
  fecha_creacion               DateTime?                      @default(now()) @db.Date
  fecha_limite                 DateTime?                      @db.Date
  created_at                   DateTime?                      @default(now()) @db.Timestamp(6)
  updated_at                   DateTime?                      @updatedAt @db.Timestamp(6)
  estrategia_actividad_enlaces estrategia_actividad_enlaces[]

  @@index([estado], map: "idx_estrategia_actividades_estado")
  @@index([prioridad], map: "idx_estrategia_actividades_prioridad")
  @@schema("comercial")
}

model estrategia_actividad_enlaces {
  id                     Int                    @id @default(autoincrement())
  actividad_id           Int
  nombre                 String                 @db.VarChar(255)
  url                    String
  created_at             DateTime?              @default(now()) @db.Timestamp(6)
  updated_at             DateTime?              @updatedAt @db.Timestamp(6)
  estrategia_actividades estrategia_actividades @relation(fields: [actividad_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([actividad_id], map: "idx_estrategia_actividad_enlaces_actividad")
  @@schema("comercial")
}

model estrategia_empresas {
  id                   Int                    @id @default(autoincrement())
  nombre               String                 @db.VarChar(200)
  descripcion          String?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @updatedAt @db.Timestamp(6)
  estrategia_proyectos estrategia_proyectos[]

  @@schema("comercial")
}

model estrategia_proyectos {
  id                          Int                           @id @default(autoincrement())
  empresa_id                  Int?
  titulo                      String                        @db.VarChar(200)
  descripcion                 String?
  estado                      EstrategiaProyectoEstado      @default(PENDIENTE)
  fecha_limite                DateTime?                     @db.Date
  created_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?                     @updatedAt @db.Timestamp(6)
  estrategia_proyecto_enlaces estrategia_proyecto_enlaces[]
  estrategia_empresas         estrategia_empresas?          @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([empresa_id], map: "idx_estrategia_proyectos_empresa")
  @@index([estado], map: "idx_estrategia_proyectos_estado")
  @@schema("comercial")
}

model estrategia_proyecto_enlaces {
  id                   Int                   @id @default(autoincrement())
  proyecto_id          Int?
  etiqueta             String                @db.VarChar(255)
  url                  String
  created_at           DateTime?             @default(now()) @db.Timestamp(6)
  updated_at           DateTime?             @updatedAt @db.Timestamp(6)
  estrategia_proyectos estrategia_proyectos? @relation(fields: [proyecto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([proyecto_id], map: "idx_estrategia_proyecto_enlaces_proyecto")
  @@schema("comercial")
}

model estrategia_tareas {
  id                                                 Int       @id @default(autoincrement())
  area_id                                            Int?
  titulo                                             String    @db.VarChar(255)
  descripcion                                        String?
  estado                                             String?   @default("PENDIENTE") @db.VarChar(50)
  prioridad                                          String?   @db.VarChar(20)
  fecha_vencimiento                                  DateTime? @db.Date
  creador_id                                         Int?
  asignado_a_id                                      Int?
  fecha_creacion                                     DateTime? @default(now()) @db.Timestamp(6)
  areas                                              areas?    @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios_estrategia_tareas_asignado_a_idTousuarios usuarios? @relation("estrategia_tareas_asignado_a_idTousuarios", fields: [asignado_a_id], references: [id], onUpdate: NoAction)
  usuarios_estrategia_tareas_creador_idTousuarios    usuarios? @relation("estrategia_tareas_creador_idTousuarios", fields: [creador_id], references: [id], onUpdate: NoAction)

  @@index([estado], map: "idx_tareas_estrategia_estado")
  @@schema("comercial")
}

model areas {
  id                     Int                      @id @default(autoincrement())
  nombre                 String                   @db.VarChar(100)
  padre_id               Int?
  es_externa             Boolean?                 @default(false)
  config_conexion        Json?
  config_visual          Json?
  analisis_tareas        analisis_tareas[]
  convenios              convenios[]
  desarrollo_actividades desarrollo_actividades[]
  estrategia_tareas      estrategia_tareas[]
  areas                  areas?                   @relation("areasToareas", fields: [padre_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_areas            areas[]                  @relation("areasToareas")
  canales                canales[]
  permisos_area          permisos_area[]
  proyectos              proyectos[]
  publicaciones          publicaciones[]
  recursos_area          recursos_area[]
  repositorio_bloques    repositorio_bloques[]

  @@index([padre_id], map: "idx_areas_padre")
  @@schema("core")
}

model canales {
  id                  Int                   @id @default(autoincrement())
  nombre              String?               @db.VarChar(100)
  area_id             Int?
  es_grupo            Boolean?              @default(true)
  fecha_creacion      DateTime?             @default(now()) @db.Timestamp(6)
  avatar_url          String?
  descripcion         String?               @db.VarChar(255)
  areas               areas?                @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mensajes            mensajes[]
  participantes_canal participantes_canal[]

  @@schema("core")
}

model mensajes {
  id                 Int                  @id @default(autoincrement())
  canal_id           Int?
  emisor_id          Int?
  contenido          String
  archivo_url        String?
  leido                       Boolean?                      @default(false)
  eliminado                   Boolean?                      @default(false)
  creado_at                   DateTime?                     @default(now()) @db.Timestamp(6)
  tipo                        String?                       @db.VarChar(20)
  canales                     canales?                      @relation(fields: [canal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios                    usuarios?                     @relation(fields: [emisor_id], references: [id], onUpdate: NoAction)
  reacciones_mensaje          reacciones_mensaje[]
  mensajes_eliminados_usuario mensajes_eliminados_usuario[]

  @@index([canal_id], map: "idx_mensaje_canal")
  @@index([creado_at], map: "idx_mensajes_fecha")
  @@schema("core")
}

model notificaciones {
  id                      Int                       @id @default(autoincrement())
  usuario_id              Int?
  titulo                  String                    @db.VarChar(150)
  mensaje                 String?
  leido                   Boolean?                  @default(false)
  tipo                    String?                   @db.VarChar(50)
  creado_at               DateTime?                 @default(now()) @db.Timestamp(6)
  imagen                  String?
  notificacion_eliminadas notificacion_eliminadas[]
  notificacion_lecturas   notificacion_lecturas[]
  usuarios                usuarios?                 @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id], map: "idx_notificaciones_usuario")
  @@schema("core")
}

model notificacion_lecturas {
  notificacion_id Int
  usuario_id      Int
  leido           Boolean        @default(false)
  favorito        Boolean        @default(false)
  archivado       Boolean        @default(false)
  actualizado_at  DateTime?      @default(now()) @db.Timestamp(6)
  notificaciones  notificaciones @relation(fields: [notificacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios        usuarios       @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([notificacion_id, usuario_id])
  @@schema("core")
}

model notificacion_eliminadas {
  notificacion_id Int
  usuario_id      Int
  eliminado_at    DateTime?      @default(now()) @db.Timestamp(6)
  notificaciones  notificaciones @relation(fields: [notificacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios        usuarios       @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([notificacion_id, usuario_id])
  @@schema("core")
}

model notificacion_inicio_usuario {
  usuario_id    Int      @id
  fecha_ingreso DateTime @default(now()) @db.Timestamp(6)
  usuarios      usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("core")
}

model participantes_canal {
  canal_id   Int
  usuario_id Int
  es_admin   Boolean? @default(false)
  canales    canales  @relation(fields: [canal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios   usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([canal_id, usuario_id])
  @@schema("core")
}

model reacciones_mensaje {
  id         Int      @id @default(autoincrement())
  mensaje_id Int
  usuario_id Int
  emoji      String   @db.VarChar(10)
  creado_at  DateTime @default(now()) @db.Timestamp(6)
  mensajes   mensajes @relation(fields: [mensaje_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios   usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([mensaje_id], map: "idx_reacciones_mensaje_mensaje")
  @@index([usuario_id], map: "idx_reacciones_mensaje_usuario")
  @@schema("core")
}

model permisos_area {
  id                Int       @id @default(autoincrement())
  usuario_id        Int?
  area_id           Int?
  permitir_subareas Boolean?  @default(true)
  puede_publicar    Boolean?  @default(false)
  puede_editar      Boolean?  @default(false)
  areas             areas?    @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios          usuarios? @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuario_id, area_id])
  @@index([area_id], map: "idx_permiso_area")
  @@index([usuario_id], map: "idx_permiso_usuario")
  @@schema("core")
}

model proyectos {
  id             Int       @id @default(autoincrement())
  titulo         String    @db.VarChar(100)
  tipo           String?   @db.VarChar(50)
  estado         String?   @default("EN EJECUCION") @db.VarChar(50)
  fecha_inicio   DateTime? @db.Date
  fecha_fin      DateTime? @db.Date
  area_id        Int?
  responsable_id Int?
  fecha_creacion DateTime? @default(now()) @db.Timestamp(6)
  areas          areas?    @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios       usuarios? @relation(fields: [responsable_id], references: [id], onUpdate: NoAction)

  @@schema("core")
}

model director_evaluaciones {
  id          Int       @id @default(autoincrement())
  director_id Int?
  rating      Int
  comentario  String?   @db.VarChar(500)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  usuario_id  Int?
  director    usuarios? @relation("DirectorEvaluationsDirector", fields: [director_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario     usuarios? @relation("DirectorEvaluationsUsuario", fields: [usuario_id], references: [id], onUpdate: NoAction)

  @@index([director_id], map: "idx_director_evaluaciones_director")
  @@index([usuario_id], map: "idx_director_evaluaciones_usuario")
  @@schema("core")
}

model publicaciones {
  id                Int       @id @default(autoincrement())
  area_id           Int?
  autor_id          Int?
  titulo            String    @db.VarChar(200)
  contenido         String?
  imagen_url        String?
  fecha_publicacion DateTime? @default(now()) @db.Timestamp(6)
  areas             areas?    @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios          usuarios? @relation(fields: [autor_id], references: [id], onUpdate: NoAction)

  @@schema("core")
}

model recursos_area {
  id             Int     @id @default(autoincrement())
  area_id        Int?
  nombre_recurso String  @db.VarChar(100)
  url_recurso    String
  tipo_recurso   String? @db.VarChar(50)
  icono          String? @db.VarChar(50)
  areas          areas?  @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([area_id], map: "idx_recursos_area")
  @@schema("core")
}

model repositorio_bloques {
  id                  Int                   @id @default(autoincrement())
  area_id             Int?
  titulo              String                @db.VarChar(150)
  subtitulo           String?               @db.VarChar(150)
  icono               String?               @db.VarChar(50)
  url_drive_principal String?
  creado_por          Int?
  fecha_creacion      DateTime?             @default(now()) @db.Timestamp(6)
  areas               areas?                @relation(fields: [area_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios            usuarios?             @relation(fields: [creado_por], references: [id], onUpdate: NoAction)
  repositorio_enlaces  repositorio_enlaces[]
  repositorio_carpetas repositorio_carpetas[]

  @@index([area_id], map: "idx_repositorio_area")
  @@schema("core")
}

model repositorio_carpetas {
  id                  Int                   @id @default(autoincrement())
  bloque_id           Int?
  padre_id            Int?
  nombre              String                @db.VarChar(255)
  fecha_creacion      DateTime?             @default(now()) @db.Timestamp(6)

  repositorio_bloques repositorio_bloques?  @relation(fields: [bloque_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  carpeta_padre       repositorio_carpetas? @relation("JerarquiaCarpetas", fields: [padre_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subcarpetas         repositorio_carpetas[] @relation("JerarquiaCarpetas")
  repositorio_enlaces repositorio_enlaces[]

  @@index([bloque_id], map: "idx_carpetas_bloque")
  @@index([padre_id], map: "idx_carpetas_padre")
  @@schema("core")
}

model repositorio_enlaces {
  id                   Int                   @id @default(autoincrement())
  bloque_id            Int?
  carpeta_id           Int?
  nombre_documento     String                @db.VarChar(255)
  url_drive            String
  estado               String                @default("aprobado") @db.VarChar(20)
