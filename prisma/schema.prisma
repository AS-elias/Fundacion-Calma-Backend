  @@unique([usuario_id, contacto_id])
  @@index([contacto_id], map: "idx_solicitudes_contacto_contacto")
  @@index([estado], map: "idx_solicitudes_contacto_estado")
  @@index([usuario_id], map: "idx_solicitudes_contacto_usuario")
