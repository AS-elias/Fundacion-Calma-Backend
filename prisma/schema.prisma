  fecha_agregado       DateTime?             @default(now()) @db.Timestamp(6)
  
  repositorio_bloques  repositorio_bloques?  @relation(fields: [bloque_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  repositorio_carpetas repositorio_carpetas? @relation(fields: [carpeta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios             usuarios?             @relation(fields: [subido_por], references: [id], onUpdate: NoAction)

  @@index([bloque_id], map: "idx_enlaces_bloque")
  @@index([carpeta_id], map: "idx_enlaces_carpeta")
  @@schema("core")
}

model roles {
